{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jay-vale-sound-library",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "r2_buckets": [
    {
      "binding": "SAMPLES"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://jayvalemusic.com",
    "MAX_LIBRARY_BYTES": "9500000000",
    "MAX_SAMPLE_BYTES": "15000000"
  },
  "keep_vars": true
}
